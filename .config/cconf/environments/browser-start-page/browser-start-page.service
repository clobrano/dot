[Unit]
Description=Local browser start page

[Service]
ExecStart=/usr/bin/python3 %h/.config/cconf/environments/browser-start-page/start-page-server.py --port 8420 --bind 0.0.0.0 --bind :: --directory %h/.config/cconf/environments/browser-start-page
Restart=on-failure

[Install]
WantedBy=default.target
