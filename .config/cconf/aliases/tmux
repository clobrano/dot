# role (opt) marks the first notes
tmux-attach-or-create() {
    local session="$1"
    local role="$2"

    if ! tmux attach-session -t "=$session" >/dev/null 2>&1; then
        if [ -n "$role" ]; then
            tmux new-session -d -s "$session"
            tmux set-option -w -t "=$session:" @role "$role"
            tmux attach-session -t "=$session"
        else
            tmux new-session -s "$session"
        fi
    fi
}

alias t=task

alias dev="tmux-attach-or-create tmux-devel"
alias notes="tmux-attach-or-create tmux-note"

alias tas="tmux attach-session -t"
alias tks="tmux kill-session -t"
alias tls="tmux list-sessions"
alias trs="tmux rename-session"
alias trss="tmux-session-rename.sh"
